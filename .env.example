# Optional. The tool uses the local `claude` CLI (your Claude subscription) by
# default and needs no key. Set one only if you want the direct-API backend,
# e.g. on a CI machine where the CLI is not signed in.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Backend selection: auto | cli | api | heuristic
SWAGPERF_BACKEND=auto
SWAGPERF_MODEL=claude-opus-5

# Automatic PM review: after each recorded run, the product-manager agent
# opens or updates performance issues in docs/issues/ through your local
# Claude Code session. Clean runs never start a model. Set 0 to turn it off
# (and on CI, where no one reviews docs/ changes).
SWAGPERF_PM_AUTOTRIAGE=1
SWAGPERF_PM_MODEL=sonnet
